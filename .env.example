# ============================================
# Gemini API Configuration (Required)
# ============================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_api_key_here

# Gemini model to use (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash-exp, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Temperature for response generation (0.0-1.0, default: 0.2)
# Lower values = more focused/deterministic, Higher values = more creative/random
GEMINI_TEMPERATURE=0.2

# ============================================
# Robot Configuration
# ============================================
# USB serial port for SO101 robotic arm (typically /dev/ttyACM0 or /dev/ttyACM1 on Linux)
ROBOT_PORT=/dev/ttyACM1

# ============================================
# Speech-to-Text Configuration
# ============================================
# STT provider to use (default: gemini)
# Options: gemini (recommended), google_stt
STT_PROVIDER=gemini

# Google Cloud credentials for STT/TTS (optional, only needed if using google_stt provider)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================
# Application Configuration
# ============================================
# Port for Gradio web interface (default: 7860)
PORT=7860

# Logging level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG to see detailed logs including Gemini API calls
LOG_LEVEL=INFO

# ============================================
# Dataset Collection Configuration
# ============================================
# Your Hugging Face username (required for dataset recording)
# Used for dataset.repo_id when recording with lerobot-record
# Get your username from: https://huggingface.co/settings/account
HF_USER=your_huggingface_username

# ============================================
# SmolVLA Model Configuration
# ============================================
# Enable manipulation tasks using SmolVLA model (default: false)
# Set to true to enable robotic manipulation capabilities
ENABLE_MANIPULATION=false

# Path to trained SmolVLA model checkpoint (required for manipulation tasks)
# This should point to the directory containing the trained model files
# Example: checkpoints/smolvla_mortis_v1 or outputs/train/smolvla_2024-01-01/checkpoints/last
SMOLVLA_CHECKPOINT_PATH=checkpoints/smolvla_best

# Device to run SmolVLA inference on (default: auto-detect)
# Options: cuda, cpu, or leave unset for automatic detection
# SMOLVLA_DEVICE=cuda

# Maximum time (in seconds) for a manipulation task to run before timing out (default: 60.0)
# If a task exceeds this time, the robot client will be stopped and the task will end
# Note: VLA models don't have a "task complete" signal, so they run until timeout
# Tune this based on how long your tasks typically take to complete
# - Simple pick-and-place: 30-45 seconds
# - Complex multi-step: 60-90 seconds
MANIPULATION_TIMEOUT=60.0

# ============================================
# Legacy Configuration (Deprecated - No longer used)
# ============================================
# The following variables are from the old LLM API integration
# and are no longer needed with Gemini API:
# - API_KEY (replaced by GEMINI_API_KEY)
# - API_BASE_URL (no longer needed - Gemini SDK handles this)
